import { Theme } from "./types.slint";

export component Header inherits Rectangle {
    in-out property <string> cpu-load: "2.4%";
    in-out property <string> reclaimed-text: "0 B";
    in-out property <int> used-percentage: 77;
    in-out property <bool> is-scanning: false;
    in-out property <bool> is-maximized: false;
    callback close-window;
    callback minimize-window;
    callback maximize-window;

    height: 52px;
    background: Theme.bg-secondary;

    HorizontalLayout {
        spacing: 0;
        alignment: start;

        // Logo + Title area
        Rectangle {
            width: 200px;
            height: 52px;

            HorizontalLayout {
                spacing: 12px;
                padding-left: 20px;
                alignment: center;

                // Logo icon
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: Theme.accent;

                    Text {
                        text: "O";
                        color: #0A0A0A;
                        font-size: 16px;
                        font-weight: 700;
                        font-family: "JetBrains Mono";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Title + subtitle
                VerticalLayout {
                    spacing: 0;
                    alignment: start;
                    Text {
                        text: "Oxidust";
                        color: Theme.text-primary;
                        font-size: 14px;
                        font-weight: 700;
                        font-family: "Space Grotesk";
                    }
                    Text {
                        text: "System Optimizer";
                        color: Theme.text-muted;
                        font-size: 9px;
                        font-family: "JetBrains Mono";
                        letter-spacing: 1px;
                    }
                }
            }
        }

        // Stats group
        Rectangle {
            height: 52px;

            HorizontalLayout {
                spacing: 28px;
                alignment: center;

                VerticalLayout {
                    spacing: 1px;
                    alignment: center;
                    Text { text: "CPU Load"; color: Theme.text-muted; font-size: 9px; letter-spacing: 1px; font-family: "JetBrains Mono"; }
                    Text { text: cpu-load; color: Theme.text-primary; font-size: 13px; font-family: "JetBrains Mono"; }
                }

                VerticalLayout {
                    spacing: 1px;
                    alignment: center;
                    Text { text: "Reclaimed"; color: Theme.text-muted; font-size: 9px; letter-spacing: 1px; font-family: "JetBrains Mono"; }
                    Text { text: reclaimed-text; color: Theme.accent; font-size: 13px; font-weight: 700; font-family: "JetBrains Mono"; }
                }

                // Disk usage bar + percentage
                Rectangle {
                    height: 52px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;

                        Rectangle {
                            width: 80px;
                            height: 5px;
                            border-radius: 16px;
                            background: #ffffff1a;

                            Rectangle {
                                width: 80px * used-percentage / 100;
                                height: 5px;
                                border-radius: 16px;
                                background: Theme.accent;
                            }
                        }

                        Text {
                            text: used-percentage + "%";
                            color: #ffffff99;
                            font-size: 10px;
                            font-family: "JetBrains Mono";
                        }
                    }
                }

                // Status badge
                Rectangle {
                    border-radius: Theme.radius-sm;
                    background: Theme.accent.transparentize(0.9);
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;
                    padding-bottom: 4px;

                    Text {
                        text: is-scanning ? "EXECUTING..." : "STANDBY";
                        color: Theme.accent;
                        font-size: 9px;
                        font-weight: 700;
                        font-family: "JetBrains Mono";
                        letter-spacing: 1px;
                    }
                }
            }
        }
    }

    // Window controls (right-aligned, macOS traffic light style)
    Rectangle {
        x: parent.width - 156px;
        y: 0px;
        width: 156px;
        height: 52px;
        padding-left: 18px;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            // Close (red)
            Rectangle {
                width: 12px; height: 12px;
                border-radius: 6px;
                background: #ff5f57;
                border-width: 1px;
                border-color: #e0443e;
                TouchArea {
                    clicked => { root.close-window(); }
                }
            }

            // Minimize (yellow)
            Rectangle {
                width: 12px; height: 12px;
                border-radius: 6px;
                background: #febc2e;
                border-width: 1px;
                border-color: #dd9e22;
                TouchArea {
                    clicked => { root.minimize-window(); }
                }
            }

            // Maximize (green)
            Rectangle {
                width: 12px; height: 12px;
                border-radius: 6px;
                background: #28c840;
                border-width: 1px;
                border-color: #1a9e2e;
                TouchArea {
                    clicked => { root.maximize-window(); }
                }
            }
        }
    }

    Rectangle {
        y: 51px;
        height: 1px;
        background: Theme.border-color;
    }
}
